{
  "copyChain": [
    {
      "src": "src/assets/javascript/bootstrap/*",
      "dest": "./dist/js/bootstrap"
    },
    {
      "src": "src/assets/javascript/jquery-inview/*",
      "dest": "./dist/js/jquery-inview"
    },
    {
      "src": "src/assets/css/index/bootstrap/*",
      "dest": "./dist/css/bootstrap/"
    },
    {
      "src": "src/assets/css/index/bootstrap-icons/**",
      "dest": "./dist/css/bootstrap-icons/"
    }
  ],
  "routes": [
    "index"
  ]
}
