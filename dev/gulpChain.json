{
  "copyChain": [
    {
      "src": "src/assets/javascript/bootstrap/*",
      "dest": "./dist/js/bootstrap"
    },
    {
      "src": "src/assets/javascript/jquery/*",
      "dest": "./dist/js/jquery"
    },
    {
      "src": "src/assets/javascript/popperjs/*",
      "dest": "./dist/js/popperjs"
    },
    {
      "src": "src/assets/javascript/jquery-inview/*",
      "dest": "./dist/js/jquery-inview"
    },
    {
      "src": "src/assets/javascript/cmanObjMove_v091/*",
      "dest": "./dist/js/cmanObjMove_v091"
    },
    {
      "src": "src/assets/css/bootstrap/*",
      "dest": "./dist/css/bootstrap/"
    },
    {
      "src": "src/assets/css/bootstrap-icons/**",
      "dest": "./dist/css/bootstrap-icons/"
    },
    {
      "src": "src/assets/images/**",
      "dest": "./dist/images/"
    }
  ],
  "routes": [
    "index"
  ]
}
