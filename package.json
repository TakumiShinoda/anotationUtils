{
  "name": "electron-template",
  "version": "1.0.0",
  "nodeVersion": "20.10.0",
  "description": "",
  "main": "./src/app/main.js",
  "scripts": {
    "start": "gulp start",
    "clean": "rm -R ./dist/",
    "clean-start": "npm run clean || npm start && npm start",
    "compile-pug": "gulp pug_compile",
    "dist": "rm -R dist || gulp build_dist && gulp build_dist",
    "test-pack-darwinx64": "rm -R *darwin-x64* || node build/darwinx64.js && node build/darwinx64.js",
    "devenv-reset": "rm -r node_modules && rm package-lock.json",
    "devenv-rebuild": "npm run devenv-reset & npm i",
    "build-copyExternals": "cp -R ./externalPackage ./publish/win-unpacked && cp -R ./settings ./publish/win-unpacked",
    "build-prepare": "npm run devenv-reset & npm run clean & rm -R publish & rm yarn.lock & yarn",
    "build-python-env": "cd ./publish/win-unpacked/externalPackage/python & setup.sh",
    "build-exe-win": "npm run build-prepare && gulp dist && electron-builder --win && npm run build-copyExternals && npm run build-python-env"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "semver": "6.3.1",
    "minimatch": "3.0.5",
    "lodash": "4.17.21",
    "graceful-fs": "4.2.10",
    "glob-parent": "6.0.1",
    "@types/node": "20.9.1"
  },
  "resolutions": {
    "semver": "6.3.1",
    "minimatch": "3.0.5",
    "lodash": "4.17.21",
    "graceful-fs": "4.2.10",
    "glob-parent": "6.0.1",
    "@types/node": "16.18.60"
  },
  "devDependencies": {
    "@types/jquery": "^3.3.14",
    "chokidar": "^3.0.0",
    "css-loader": "^6.8.1",
    "electron": "^27.1.0",
    "electron-builder": "24.13.3",
    "electron-connect": "^0.6.3",
    "electron-packager": "^17.1.2",
    "glob-stream": "^7.0.0",
    "gulp": "^4.0.2",
    "gulp-plumber": "^1.2.0",
    "gulp-pug": "^5.0.0",
    "lodash": "4.17.21",
    "style-loader": "^3.3.3",
    "ts-loader": "9.5.1",
    "typescript": "5.7.2",
    "webpack": "^5.0.0",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "electron-reload": "^2.0.0-alpha.1",
    "express": "4.21.2",
    "fs": "0.0.1-security",
    "jimp": "^0.22.10",
    "jquery": "^3.3.1",
    "path": "^0.12.7",
    "probe-image-size": "^7.2.3"
  },
  "build": {
    "directories": {
      "output": "publish"
    },
    "productName": "AnotationUtils",
    "appId": "app.anotationutils",
    "files": [
      "./src/app/**",
      "./node_modules/**",
      "./dist/**",
      "./dev/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
