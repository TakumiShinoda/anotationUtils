{
  "name": "electron-template",
  "version": "1.0.0",
  "nodeVersion": "20.10.0",
  "description": "",
  "main": "./src/app/main.js",
  "scripts": {
    "start": "gulp start",
    "clean": "rimraf ./dist/",
    "clean-start": "npm run clean || npm start && npm start",
    "compile-pug": "gulp pug_compile",
    "dist": "rimraf ./dist || gulp build_dist && gulp build_dist",
    "test-pack-darwinx64": "rm -R *darwin-x64* || node build/darwinx64.js && node build/darwinx64.js",
    "devenv-reset": "rm -R ./node_modules & rm ./package-lock.json & rm ./yarn.lock & yarn",
    "build-copyExternals": "robocopy ./externalPackage ./publish/win-unpacked/externalPackage /s /e & robocopy ./settings ./publish/win-unpacked/settings /s /e",
    "build-internal-python-asset": "npx mkdirp ./publish/win-unpacked/src/assets & robocopy ./src/assets/python ./publish/win-unpacked/src/assets/python /s /e",
    "build-prepare": "npm run devenv-reset & npm run clean & rimraf ./publish",
    "build-python-env": "cd ./publish/win-unpacked/externalPackage/python & setup.sh",
    "build-exe-win": "npm run build-prepare & gulp dist & electron-builder --win & npm run build-copyExternals & npm run build-internal-python-asset & npm run build-python-env & npx mkdirp ./publish/win-unpacked/temp",
    "plantuml-img-gen": "node ./plantUML/tools/imgGen/imgGen.js",
    "plantuml-analysis": "node ./plantUML/tools/analysis/analysis.js"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "semver": "6.3.1",
    "minimatch": "3.0.5",
    "lodash": "4.17.21",
    "graceful-fs": "4.2.10",
    "glob-parent": "6.0.1",
    "@types/node": "20.9.1"
  },
  "resolutions": {
    "semver": "6.3.1",
    "minimatch": "3.0.5",
    "lodash": "4.17.21",
    "graceful-fs": "4.2.10",
    "glob-parent": "6.0.1",
    "@types/node": "16.18.60"
  },
  "devDependencies": {
    "@types/jquery": "^3.3.14",
    "cheerio": "^1.1.2",
    "chokidar": "^3.0.0",
    "css-loader": "^6.8.1",
    "electron": "35.0.2",
    "electron-builder": "24.13.3",
    "electron-connect": "^0.6.3",
    "electron-packager": "^17.1.2",
    "glob-stream": "^7.0.0",
    "gulp": "^4.0.2",
    "gulp-plumber": "^1.2.0",
    "gulp-pug": "^5.0.0",
    "lodash": "4.17.21",
    "mkdirp": "3.0.1",
    "node-plantuml-latest": "2.4.0",
    "rimraf": "4.4.1",
    "style-loader": "^3.3.3",
    "ts-loader": "9.5.1",
    "typescript": "5.7.2",
    "webpack": "^5.0.0",
    "webpack-stream": "^7.0.0",
    "xml2js": "0.6.2"
  },
  "dependencies": {
    "electron-reload": "^2.0.0-alpha.1",
    "express": "4.21.2",
    "fs": "0.0.1-security",
    "jimp": "^0.22.10",
    "jquery": "^3.3.1",
    "open-file-explorer": "^1.0.2",
    "path": "^0.12.7",
    "probe-image-size": "^7.2.3"
  },
  "build": {
    "directories": {
      "output": "publish"
    },
    "productName": "AnotationUtils",
    "appId": "app.anotationutils",
    "files": [
      "./src/app/**",
      "./node_modules/**",
      "./dist/**",
      "./dev/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
