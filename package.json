{
  "name": "electron-template",
  "version": "1.0.0",
  "nodeVersion": "20.10.0",
  "description": "",
  "main": "./src/app/main.js",
  "scripts": {
    "start": "gulp start",
    "clean": "rimraf ./dist/",
    "clean-start": "npm run clean || npm start && npm start",
    "compile-pug": "gulp pug_compile",
    "dist": "npm run clean || gulp build_dist && gulp build_dist",
    "test-pack-darwinx64": "rm -R *darwin-x64* || node build/darwinx64.js && node build/darwinx64.js",
    "mes-none": "node -e \"console.log('')\"",
    "mes-finish": "node -e \"console.log('Finish.')\"",
    "clean-node-packages": "rm -R ./node_modules & rm ./package-lock.json & rm ./yarn.lock & npm run mes-none",
    "devenv-reset": "npm run clean-node-packages && yarn",
    "build-prepare": "npm run devenv-reset && npm run clean",
    "build-clean-publish": "rimraf ./publish",
    "build-win-builder": "electron-builder --win",
    "build-win-builder-temp": "electron-builder --win --config.directories.output=publish.temp",
    "build-copy-settings": "robocopy ./settings ./publish/win-unpacked/settings /s /e & if %ERRORLEVEL% GTR 8 (exit /b 1)",
    "build-copyExternals": "robocopy ./externalPackage ./publish/win-unpacked/externalPackage /s /e & if %ERRORLEVEL% GTR 8 (exit /b 1)",
    "build-internal-python-asset": "npx mkdirp ./publish/win-unpacked/src/assets && robocopy ./src/assets/python ./publish/win-unpacked/src/assets/python /s /e & if %ERRORLEVEL% GTR 8 (exit /b 1)",
    "build-after-proc": "node ./build/buildAfterProc.js",
    "build-python-env": "cd ./publish/win-unpacked/externalPackage/python && setup.sh",
    "build-mkdir-temp": "npx mkdirp ./publish/win-unpacked/temp",
    "build-win-full": "npm run build-prepare && npm run build-clean-publish && gulp dist && electron-builder --win && npm run build-copyExternals && npm run build-copy-settings && npm run build-internal-python-asset && npm run build-python-env && npm run build-mkdir-temp && npm run mes-finish",
    "build-win-lite": "npm run build-prepare && gulp dist && npm run build-win-builder-temp && npm run build-after-proc && npm run build-internal-python-asset && npm run build-copy-settings && npm run build-mkdir-temp && npm run mes-finish"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jquery": "3.5.33",
    "@types/node": "20.9.1",
    "chokidar": "3.0.0",
    "css-loader": "6.8.1",
    "electron": "35.0.2",
    "electron-builder": "24.13.3",
    "electron-connect": "0.6.3",
    "electron-packager": "17.1.2",
    "glob-stream": "7.0.0",
    "gulp": "5.0.1",
    "gulp-plumber": "1.2.0",
    "gulp-pug": "5.0.0",
    "lodash": "4.17.21",
    "mkdirp": "3.0.1",
    "rimraf": "4.4.1",
    "style-loader": "3.3.3",
    "ts-loader": "9.5.1",
    "typescript": "5.7.2",
    "webpack": "5.80.0",
    "webpack-stream": "7.0.0"
  },
  "dependencies": {
    "electron-reload": "2.0.0-alpha.1",
    "express": "4.21.2",
    "fs": "0.0.1-security",
    "glob-parent": "6.0.1",
    "graceful-fs": "4.2.10",
    "jimp": "0.22.10",
    "jquery": "3.3.1",
    "js-yaml": "4.1.0",
    "minimatch": "3.0.5",
    "open-file-explorer": "1.0.2",
    "path": "0.12.7",
    "probe-image-size": "7.2.3",
    "semver": "6.3.1",
    "zod": "3.25.56"
  },
  "build": {
    "icon": "./build/icons/app_icon.ico",
    "directories": {
      "output": "publish"
    },
    "productName": "AnotationUtils",
    "appId": "app.anotationutils",
    "files": [
      "./src/app/**",
      "./node_modules/**",
      "./dist/**",
      "./dev/**"
    ],
    "win": {
      "icon": "./build/icons/app_icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
