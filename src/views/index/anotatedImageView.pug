div#anotatedImageView.views.diaplayNone
  div#selectDatabaseViewprogressBarArea
    div.progress(role='progressbar' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100')
      div.progress-bar.progress-bar-striped.progress-bar-animated
  div#anotatedImageViewHeader
    h2#anotatedImageViewHeaderName Databases
  div#anotatedImageViewContentArea
    div#selectDatabaseListArea
      ul#selectDatabaseListAreaList.list-group.scroll-y-default
    div#anotatedImageViewArea
      div#anotatedImageViewAreaHeader
        div#anotatedImageViewAreaSelectModeBtnArea
          div#anotatedImageViewAreaSelectAllBtn.btn.btn-primary Select All
          div#anotatedImageViewAreaClearSelectBtn.btn.btn-danger Clear
        div
          input#anotatedImageViewAreaSelectModeBtn.btn-check(type='checkbox' name='options-outlined' autocomplete='off')
          label#anotatedImageViewAreaSelectModeBtnLabel.btn.btn-outline-primary(for='anotatedImageViewAreaSelectModeBtn') Select Mode
      div#anotatedImageViewAreaContentsArea.scroll-y-default
      div#anotatedImageViewAreaFooter
        div
          div#anotatedImageViewAreaBackBtn.btn.btn-danger Back
        div
          div.btn.btn-success export
          div#anotatedImageViewAreaSaveBtn.btn.btn-primary save