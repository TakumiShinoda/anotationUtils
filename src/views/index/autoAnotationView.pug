div#autoAnotationView.views
  div#autoAnotationViewProgressBarArea
    div.progress(role='progressbar' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100')
      div.progress-bar.progress-bar-striped.progress-bar-animated
  div.displayFlex(style='margin-bottom: 20px;')
    label Name
    input#anotationNameInputField(type='text')
  label Model Path
  div.displayFlex(style='margin-bottom: 20px;')
    div#modelPathInputButton.btn.btn-primary Reference
    input#modelPathInputField(type='text')
  label Images Path
  div.displayFlex(style='margin-bottom: 20px;')
    div#imagePathInputButton.btn.btn-primary Reference
    input#imagePathInputField(type='text')
  div.displayFlex(style='margin-bottom: 20px; justify-content: right; align-items: center;')
    div#startLoadButton.btn.btn-success Load