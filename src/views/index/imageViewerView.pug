div#imageViewerView.views.diaplayNone
  div(style='height: 10%;')
    h2 Image Viewer
  div(style='height: 10%;')
    div.displayFlex(style='margin-bottom: 20px;')
      input#openFolderDirInputField(type='text')
      div#openFolderBtn.btn.btn-primary Reference
    div.displayFlex(style='margin-bottom: 20px; justify-content: right; align-items: center;')
      div#loadFolderBtn.btn.btn-success Load
  div(style='height: 10%;')
    div Preview size
    div.displayFlex(style='margin-bottom: 10px;')
      input#imageViewImageSizeSlider(type='range' min='100' max='300' step='10' value=100 disabled)
      div#imageViewImageSize 100
    div
      span#imageCounts 0
      span  : images
  div(style='height: 70%;')
    div#imagePreviewArea.displayFlex(style='height: 100%;position: relative;overflow-y: scroll;flex-wrap:wrap;')
  div#imageViewAreaBackground
    div#imageViewControlArea(width="100%" height="50px" style="background:rgba(192,192,192,0.5)")
      i#imageViewCloseBtn.bi.bi-x-lg.icon.nodragmovable
    div#imageViewArea(cmanOMat="area")
      div#imageViewPrevNextArea
        div#imageViewPrevBtn <
        div#imageViewNextBtn >