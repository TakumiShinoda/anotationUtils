div#imageViewerView.views.diaplayNone
  div(style='height: 50px;')
    h2 Image Viewer
  div(style='height: 100px;')
    div.displayFlex(style='margin-bottom: 20px;')
      input#openFolderDirInputField(type='text')
      div#openFolderBtn.btn.btn-primary Reference
    div.displayFlex(style='margin-bottom: 20px; justify-content: space-between; align-items: center;')
      div#loadModeSelectArea.btn-group-toggle(data-toggle="buttons")
        label.btn.btn-outline-info.active(for='previewModeAll' loadMode="AllImg") All Img
          input#previewModeAll.btn-check(type='radio' name='options' autocomplete='off')
        label.btn.btn-outline-danger(for='previewModeDir' loadMode="Directory") Directory
          input#previewModeDir.btn-check(type='radio' name='options' autocomplete='off')
      div#loadFolderBtn.btn.btn-success Load
  div(style='min-height: 90px;')
    div.displayFlex
      div
        div Preview size
        div.displayFlex(style='margin-bottom: 10px;')
          input#imageViewImageSizeSlider(type='range' min='100' max='300' step='10' value=100 disabled)
          div#imageViewImageSize 100
      div(style='margin-left: 15px;')
        div Max preview images
        input#imageViewMaxPreviewImagesSlider(type='range' min='0' max='10000' step='100' value=1000)
        input#imageViewMaxPreviewImagesInput(type='number' style='width: 70px;' min='1' max='10000' value=1000)
    div(style='display: flex; justify-content: space-between; margin-right: 25px;')
      div
        div
          span#imageCounts 0
          span  : images
      div#imagePreviewNaviArea(style='display: flex;')
        div#previewAreaPager(style='display: none;')
  div(style='height: calc(100% - 240px); position: relative;')
    div#imagePreviewArea
    div#imagePreviewAreaLoadingArea(style="position: absolute; width: 100%; height: 100%;")
      img(src="../../images/loading.webp" width="40%" height="auto")
  div#imageViewAreaBackground
    div#imageViewControlArea(width="100%" height="50px" style="background:rgba(192,192,192,0.5)")
      i#imageViewCloseBtn.bi.bi-x-lg.icon.nodragmovable
    div#imageViewArea(cmanOMat="area")
      div#imageViewPrevNextArea
        div#imageViewPrevBtn <
        div#imageViewNextBtn >